# Sourced by /usr/bin/pinentry (Arch's wrapper) before it picks a backend.
# Hyprland makes it try GNOME, then GTK 2, which has no dark theme here and
# shows GPG's passphrase prompt in white. The Qt one follows qt6ct instead,
# dark like the rest; without it installed, the wrapper carries on as usual.
# The same check the wrapper does for its own picks: a pinentry-qt whose Qt
# libraries do not load would fail the prompt instead of falling back.
_hyprflow_qt="$(command -v pinentry-qt)" && ! ldd "$_hyprflow_qt" 2>/dev/null | grep -q 'not found' &&
    exec "$_hyprflow_qt" "$@"
