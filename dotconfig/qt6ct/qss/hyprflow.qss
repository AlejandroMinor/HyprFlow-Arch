/* HyprFlow touches on Fusion's dark palette: rounded, roomier buttons and
   inputs, like the rofi menus, and a clear focus ring. */

QPushButton {
    background-color: #2b2b2b;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 6px 18px;
    min-width: 64px;
}
QPushButton:hover   { background-color: #353535; }
QPushButton:pressed { background-color: #1f1f1f; }
QPushButton:default { border: 1px solid #7aa2f7; }

QLineEdit, QComboBox, QSpinBox {
    background-color: #1a1a1a;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 5px 8px;
    selection-background-color: #7aa2f7;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #7aa2f7; }
