/**
 * Fixed colours, the same as the Quickshell panels (Colors.qml): they do not
 * follow wallust.
 */
* {
    foreground: #FFFFFF;
    muted:      #FFFFFF73;   /* 45%: the panels' placeholder */
    accent:     #FFFFFF;     /* prompt */
    active:     #3DFF3D;
    bg-solid:   #000000;

    bg-window:  #00000061;   /* 38%: the panel card */
    bg-input:   #00000000;   /* none: the panels have no input box */
    sel-bg:     #0000008C;   /* 55%: the panels' selection */
    separator:  #FFFFFF14;   /* 8%: the card border */
}
